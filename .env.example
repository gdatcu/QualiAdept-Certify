# Database connection strings (PostgreSQL / Supabase)
DATABASE_URL="postgresql://user:password@localhost:5432/qualiadept?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/qualiadept?direct=true"

# NextAuth.js (Auth.js) Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-random-secret-at-least-32-chars-long"

# GitHub OAuth Credentials (GitHub Developer Settings -> OAuth Apps)
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_ID="your-github-oauth-client-id"
GITHUB_CLIENT_SECRET="your-github-oauth-client-secret"

# Enrollment Access Token & Expiration Date
ENROLLMENT_TOKEN="your_token_here"
TOKEN_EXPIRATION_DATE="YYYY-MM-DD"

# Community Webhooks (Discord Triumph Notifications)
DISCORD_WEBHOOK_URL=""

# Google Gemini API Key for Virtual Mentor AI Code Reviewer
GOOGLE_GENERATIVE_AI_API_KEY=""

# Phase 2 Dynamic Validation: Private GitHub Actions Playwright Runner
# Leave unset in local dev to fall back cleanly to Stage 1 Static Hygiene Gate
EVAL_RUNNER_REPO="gdatcu/qualiadept-eval-runner"
EVAL_RUNNER_WORKFLOW="playwright-eval.yml"
EVAL_RUNNER_REF="main"
EVAL_RUNNER_TOKEN=""
EVAL_CALLBACK_SECRET=""
EVAL_CALLBACK_BASE_URL="https://certify.qualiadept.eu"
