# Database connection strings (PostgreSQL / Supabase)
DATABASE_URL="postgresql://user:password@localhost:5432/qualiadept?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/qualiadept?direct=true"

# NextAuth.js (Auth.js) Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-random-secret-at-least-32-chars-long"

# GitHub OAuth Credentials (GitHub Developer Settings -> OAuth Apps)
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_ID="your-github-oauth-client-id"
GITHUB_CLIENT_SECRET="your-github-oauth-client-secret"

# Enrollment Access Token & Expiration Date
ENROLLMENT_TOKEN="your_token_here"
TOKEN_EXPIRATION_DATE="YYYY-MM-DD"

# Community Webhooks (Discord Triumph Notifications)
DISCORD_WEBHOOK_URL=""


